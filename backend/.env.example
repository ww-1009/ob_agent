# 示例环境变量：复制为 backend/.env 后填入真实值
#   cp backend/.env.example backend/.env
# backend/.env 已被 .gitignore 忽略，不会入库。
#
# 注意：环境变量（非空）优先级高于 backend/config.yaml。
# 留空的键不会覆盖 YAML —— 若在此处填了占位值（如 http://xxxxxx），就会盖掉
# config.yaml 里已配好的值，导致连不上模型/数据库。不需要覆盖时请保持留空或注释掉。

# ---- OCP ----
OCP_PROVIDER=real
OCP_BASE_URL=https://<ocp-host>:<port>
OCP_USERNAME=<ocp-admin-account>
OCP_PASSWORD=<ocp-password>
OCP_VERIFY_SSL=true

# ---- 只读 SQL 执行器 ----
SQL_RO_PROVIDER=real
# 集群名 -> "host:port" 的 dict 字符串（键须与工具调用传入的 cluster_name 完全一致）
SQL_RO_HOST_MAP={'<cluster-name>': '<obproxy-host>:3306'}
SQL_RO_USERNAME=<ro-account>
SQL_RO_PASSWORD=<ro-password>
# ---- 以下一项仅 Oracle 模式租户使用（MySQL 模式忽略）----
# Oracle 的 DSN service name 与用户名的租户后缀都取自工具调用参数（db_name / tenant_name / cluster_name）
SQL_RO_DRIVER=oracledb

# ---- LLM（OpenAI 兼容；base_url / api_key / model 三者齐全才算「已配置」）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_INPUT_TOKENS=250000

# ---- agent ----
SEND_ROW_DATA=true
# CONFIRM_DB_OPS=true            # 变更类操作是否要人工确认（HITL 审批）
# CONFIRM_TIMEOUT_SECONDS=120    # 等待人工确认的超时；超时按「拒绝」处理
# RECURSION_LIMIT=100            # langgraph 单轮图步数上限，防止工具调用打转

# ---- 会话记忆（PostgreSQL，可选）----
# 一般只改 backend/config.yaml 的 memory 段即可；确需环境变量覆盖时取消注释
# MEMORY_ENABLED=true
# MEMORY_DSN=postgresql://<user>:<password>@127.0.0.1:5432/llm_db
# MEMORY_HOST=127.0.0.1
# MEMORY_PORT=5432
# MEMORY_USER=<pg-user>
# MEMORY_PASSWORD=<pg-password>
# MEMORY_DBNAME=llm_db
# MEMORY_AUDIT_RETENTION_DAYS=0        # >0 时启动清理更早的审计行；0 = 永久保留
# MEMORY_OPEN_TIMEOUT_SECONDS=5        # 启动打开连接的等待上限
# MEMORY_OPEN_ATTEMPTS=2               # 启动尝试次数

# ---- 访问控制（可选，但暴露到非可信网络时强烈建议开启）----
# 开启后除 /api/health 外所有 /api 都要求 Authorization: Bearer <token>
# AUTH_ENABLED=true
# AUTH_TOKEN=<随机长令牌>

# ---- 检索 / embedding / rerank（可选；一般只改 backend/config.yaml，确需覆盖时取消注释）----
# 环境变量（非空）优先级高于 backend/config.yaml；填了占位值反而会盖掉 YAML 里的真实值
# RETRIEVAL_MILVUS_PATH=doc/ob_wiki.milvus.db
# RETRIEVAL_DEFAULT_RETRIEVER=sparse     # sparse | dense | hybrid（M7 起 FTS5 已删除）
# ---- 稠密一路的外部 Embedding（OpenAI 兼容，含 /v1；base_url + model 非空才算已配置）----
# EMBEDDING_BASE_URL=https://<embedding-host>/v1
# EMBEDDING_API_KEY=<embedding-api-key>  # 本地 Ollama/vLLM 可留空
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIMS=1024
# EMBEDDING_BATCH_SIZE=16                # DashScope 兼容模式硬上限 20，超限 400
# ---- 后置重排（mode: auto | off | api；protocol: jina | dashscope）----
# RERANK_MODE=auto
# RERANK_PROTOCOL=jina                   # 阿里云百炼 compatible-mode/v1 无 /rerank，须用 dashscope
# RERANK_BASE_URL=https://<rerank-host>/v1
# RERANK_API_KEY=<rerank-api-key>
# RERANK_MODEL=

# ---- 应用日志（可选；一般只改 backend/config.yaml，确需覆盖时取消注释）----
# 默认落盘 backend/logs/app.log（5MB × 5 轮转），stderr 也照常输出（systemd 下进 journald）
# LOG_LEVEL=INFO                         # NOTSET | DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FILE=logs/app.log                  # 相对路径按 backend/ 解析
# LOG_MAX_BYTES=5000000                  # <=0 不轮转
# LOG_BACKUPS=5
# LOG_CONSOLE=true
# LOG_THIRD_PARTY_LEVEL=WARNING          # pymilvus/grpc/httpx/jieba 等库的级别
