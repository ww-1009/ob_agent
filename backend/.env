# 复制为 backend/.env 并填写真实值（.env 不入库）
OCP_PROVIDER=real
OCP_BASE_URL=http://xxxx:8080
OCP_USERNAME=xxx
OCP_PASSWORD=xxxx
OCP_VERIFY_SSL=true

SQL_RO_PROVIDER=real
SQL_RO_HOST_MAP={'test_shrbank_ob001': 'obproxy.ops.clouddev.shrbk:3306', 'test_shrbank_ob002': 'obproxy-117c.ops.clouddev.shrbk:3306','test_shrbank_ob003': 'obproxy-140e.ops.clouddev.shrbk:3306'}
SQL_RO_USERNAME=xxxxx
SQL_RO_PASSWORD=xxxxx

META_DB_PROVIDER=real
META_DB_HOST=obproxy.ops.clouddev.shrbk
META_DB_PORT=3306
META_DB_NAME=llm_db
META_DB_USERNAME=llm@xxx#test_shrbank_ob001
META_DB_PASSWORD=xxxxx

LLM_BASE_URL=http://xxxxxx
LLM_API_KEY=xxxxxxx
LLM_MODEL=Qwen3.5-MoE-122B-A10B
LLM_MAX_INPUT_TOKENS=250000

SEND_ROW_DATA=true
